#!/bin/sh
# media-server — the Sasonica server: what the app pairs with and talks to
# (pairing, threads, Home, search, contacts, the Map…), and the canvas page
# beside spoken replies. It was `agent-media-visual-canvas`, a hand-placed
# unit with five drop-ins, until 14 Nov 2026; now a template like the rest,
# installed where the host declares the `server` role
# (docs/proposals/2026-11-13-the-canvas-becomes-the-server.md, change 1 and 2).
#
# Settings, from ~/.config/agent-media.env (the unit reads it too):
#   MEDIA_VISUAL_BIND    where the main listener binds: an address, or
#                        `tailnet` for this host's tailnet address (from
#                        $XDG_RUNTIME_DIR/tailnet-ip.env, waited for up to a
#                        minute at boot); default 127.0.0.1
#   MEDIA_VISUAL_PORT    its port (8781)
#   MEDIA_VISUAL_PUBLIC  HOST:PORT of the app-routes-only listener a tunnel
#                        points at (e.g. 127.0.0.1:8789); unset, none
#   MEDIA_PUBLIC_URL, MEDIA_WEB_APP_DIR, MEDIA_TIMELINE_SOURCES … as before
# and ~/.config/agent-media/matrix.env when it exists (the Matrix rooms).
exec 2>&1
set -a
[ -f "$HOME/.config/agent-media.env" ] && . "$HOME/.config/agent-media.env"
[ -f "$HOME/.config/agent-media/matrix.env" ] && . "$HOME/.config/agent-media/matrix.env"
set +a
bind="${MEDIA_VISUAL_BIND:-127.0.0.1}"
if [ "$bind" = tailnet ]; then
    f="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tailnet-ip.env"
    i=0
    while [ ! -s "$f" ] && [ "$i" -lt 60 ]; do sleep 1; i=$((i + 1)); done
    TS_IP=""
    [ -s "$f" ] && . "$f"
    if [ -z "$TS_IP" ]; then
        echo "media-server: MEDIA_VISUAL_BIND=tailnet but no TS_IP in $f after 60 s" >&2
        exit 1
    fi
    bind="$TS_IP"
fi
exec media-visual-canvas --bind "$bind" --port "${MEDIA_VISUAL_PORT:-8781}"
